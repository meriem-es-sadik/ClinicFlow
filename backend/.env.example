# ---------------------------------------------------------------------------
# ClinicFlow backend environment variables
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=clinicflow
# Set to "true" when your PostgreSQL server requires TLS (e.g. some cloud hosts)
PGSSL=false

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# CORS - comma separated list of allowed origins for the React app
CORS_ORIGIN=http://localhost:5173

# Business rule: confirmed appointments must be at least this many minutes apart
APPOINTMENT_CONFLICT_WINDOW_MINUTES=30
