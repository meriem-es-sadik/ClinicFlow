{
  "name": "clinicflow-backend",
  "version": "1.0.0",
  "description": "ClinicFlow REST API - patients, appointments, auth and dashboard for a small clinic.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "node src/db/reset.js && npm run db:setup",
    "test": "jest --runInBand --detectOpenHandles",
    "test:smoke": "node scripts/api-smoke.js"
  },
  "keywords": [
    "clinic",
    "express",
    "postgres",
    "rest-api"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
